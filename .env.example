# Required: Supabase configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_API_KEY=your_supabase_anon_key
DATABASE_PASSWORD=your_database_password

# ── REQUIRED: Site domain + Chaturbate auth ───────────────
# The recorder records from cb.xxx (your clone of chaturbate), not chaturbate.com.
DOMAIN=https://www.cb.xxx/
# Get these from your browser after logging into cb.xxx.
# CRITICAL: Use Chrome 146+ on Windows to match the TLS fingerprint preset.
#   Chrome:  F12 → Application → Cookies → cb.xxx → copy all as string
#   Firefox: F12 → Storage → Cookies → cb.xxx
# If cookies were collected from a different browser version, Cloudflare may
# still challenge the request (cf_clearance is bound to the TLS fingerprint).
COOKIES="sessionid=your_session_id; csrftoken=your_csrftoken"
# Automatically run scripts/cookie_refresher.py at every startup to fetch
# fresh cookies from the site (requires Python + curl_cffi). Set to false to
# disable and keep using stored cookies.
REFRESH_COOKIES=true
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/146.0.0.0 Safari/537.36"

# ── IP REPUTATION ────────────────────────────────────────
# Cloudflare also scores your IP address. Residential/home ISP IPs work best.
# Datacenter/VPS IPs (AWS, DigitalOcean, Hetzner, GitHub Actions runners,
# etc.) often get challenged or blocked even with a perfect TLS fingerprint.
# This build connects directly (no proxy). If your IP is challenged:
#   - Use a VPN on the machine for a residential exit IP
#   - Or accept that some channels may be intermittently blocked

# Optional: Upload host API keys
IMGBB_API_KEY=your_imgbb_api_key[,key2,key3]
IMGPILE_KEY=your_imgpile_api_key
# VOE.sx and Vidara support comma-separated key lists for rotation: when a key
# is invalidated (403 / auth failure) or VOE's storage quota is exhausted, the
# uploader rotates to the next key during the same attempt instead of giving
# up / disabling the host for the rest of the run.
VOESX_API_KEY=your_voesx_api_key[,key2,key3]
VIDARA_KEY=your_vidara_api_key[,key2,key3]
SENDCM_API_KEY=your_sendcm_api_key
BYSE_API_KEY=your_byse_api_key

# ── Catbox proxy (RECOMMENDED for nodes) ────────────────────────
# Catbox.moe blocks datacenter/VPS IP ranges with HTTP 412 "Invalid uploader"
# (the nodes run on exactly those networks). Route Catbox uploads through a
# Cloudflare Worker proxy instead:
#   1. Deploy the worker in workers/catbox-proxy (npx wrangler deploy)
#   2. Set CATBOX_PROXY_URL to the worker's URL on every node
# The Go uploader POSTs to this URL; the worker forwards to catbox.moe from
# Cloudflare's edge IPs, which are not blocked. Nodes get this via the
# CATBOX_PROXY_URL GitHub Actions secret (merged into .env by
# scripts/parallel-setup.ps1).
CATBOX_PROXY_URL=https://your-worker.your-subdomain.workers.dev
# Optional: Catbox userhash from your account settings (https://catbox.moe).
# Anonymous uploads expire after 1 hour; with a valid userhash previews are
# permanent. Leave empty to stay anonymous. IMPORTANT: only set a VALID
# userhash — Catbox rejects invalid ones with 412 "Not signed in!".
CATBOX_USERHASH=bfd94ac28656b26ad6fbb4506

# ── Upload throughput tuning ───────────────────────────────
# Raise to drain large upload backlogs faster. Each file fans out to all hosts
# in parallel; per-host concurrency caps how many simultaneous uploads a host
# accepts before it starts rate-limiting (429s are retried automatically).
# UPLOAD_MAX_CONCURRENT=100     # max video files uploading at once
# UPLOAD_HOST_CONCURRENCY=8     # max concurrent uploads per host
# PIPELINE_WORKERS=3            # concurrent pipelines per channel queue

# Optional: GitHub preview fallback
GITHUB_TOKEN=your_github_token
GITHUB_REPO=owner/repo
GITHUB_BRANCH=main
GITHUB_PREVIEW_PATH=previews


# Optional: Chaturbate API pacing for large channel lists.
# HLS playlist/segment downloads are not limited by these; only stream discovery
# calls are paced. Raise cautiously when using strong residential/proxy IPs.
CHATURBATE_API_INITIAL_RPS=25
CHATURBATE_API_MIN_RPS=5
CHATURBATE_API_MAX_RPS=100
CHATURBATE_API_BURST=250

# Optional: Instance ID for multi-instance isolated setups
INSTANCE_ID=default

# ── DISTRIBUTED SHARDS (Pooled Mode) ──────────────────────
# Set CHANNEL_POOL_MODE=pooled to enable distributed recording across multiple
# nodes sharing one Supabase database. Auto-detected if NODE_ID is unset.
# CHANNEL_POOL_MODE=pooled
# NODE_ID=node-a

# Human-readable label for this node (shown in the web UI node table).
# INSTANCE_LABEL=

# Public web URL for this node's web UI so other nodes can link to it.
# Set to your cloudflared tunnel URL or VPS address + port.
# NODE_WEB_URL=https://your-node.example.com

# ── RECORDING SESSION LENGTH ───────────────────────────────
# After this elapses the system stops all channels, uploads, writes
# upload-complete.flag, rebalances, and restarts the recording cycle.
# A single central value lives in Supabase (app_settings # key "session_duration")
# and is SHARED by every node, so nodes also no per-node env is required:
#   set it once, anywhere, via:  POST /api/session/duration  {"duration":"5h20m0s"}
# Precedence: 1) SESSION_DURATION env/flag (per-node override)  2) central value
#   3) CI-safe fallback (5h35m) when running on a GitHub Actions runner.
# For 6-hour temporary runners recording many channels, leave upload time.
SESSION_DURATION=5h20m0s

# Never force-stop channels before the session duration elapses, even if the
# pending upload backlog can't finish before the run deadline (RUN_DEADLINE).
# By default the session loop stops channels early (~3h into a 5h20m session)
# whenever the estimated upload ETA would overrun the runner's hard deadline.
# Set to "true" to record the FULL configured session and drain the backlog at
# the natural session boundary instead.
# DISABLE_EARLY_DRAIN=false
